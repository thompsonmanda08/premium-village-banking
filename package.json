{
  "name": "premium-village-bank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tokens": "node scripts/check-tokens.mjs src",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "ledger:import": "bun scripts/ledger-import.mjs",
    "db:push": "bun scripts/db-cli.mjs push",
    "db:reset": "bun scripts/db-cli.mjs reset",
    "db:test": "bun scripts/db-test.mjs",
    "db:types": "bun scripts/db-cli.mjs types",
    "fn:test": "bun x deno test --allow-env supabase/functions/invite-member/lib.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2",
    "@tanstack/query-async-storage-persister": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "idb-keyval": "^6",
    "lucide-react": "^1.53.0",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-router": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.64",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vite-pwa/assets-generator": "^1",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^5",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postgres": "^3.4.9",
    "supabase": "^2",
    "tailwindcss": "^4",
    "typescript": "~5.8",
    "typescript-eslint": "^8",
    "vite": "^6.4",
    "vite-plugin-pwa": "^1.3",
    "vitest": "^3.2"
  },
  "overrides": {
    "vite": "$vite"
  }
}
