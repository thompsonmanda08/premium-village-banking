# Placeholders only. Copy to supabase/functions/.env (gitignored) for `supabase functions serve --env-file`,
# or set as Edge Function secrets with `supabase secrets set`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the platform: do not add them here.
SITE_URL=http://localhost:3000
# Extra browser origins allowed to call the function (comma-separated, exact match, no wildcards).
# Vercel preview origins go here, e.g. https://premium-village-bank-git-branch-team.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
