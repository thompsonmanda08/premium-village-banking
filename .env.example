# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Browser / public: bundled into the app, safe to expose -------------------
# Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Dashboard > Project Settings > API > anon / publishable key
VITE_SUPABASE_ANON_KEY=

# --- CLI only / secret: never prefix with VITE_, never commit -----------------
# Project ref: the subdomain of the project URL (abcdefghijklmnop)
SUPABASE_PROJECT_REF=
# Dashboard > Account > Access Tokens (used by `supabase gen types`)
SUPABASE_ACCESS_TOKEN=
# Dashboard > Connect > Session pooler (port 5432), password included.
# Used by db:push, db:reset, db:test. Percent-encode special characters in the password.
SUPABASE_DB_URL=
# Dashboard > Project Settings > Database > Database password
SUPABASE_DB_PASSWORD=
# Ref of the production project. db:reset refuses any SUPABASE_DB_URL that names it.
PROD_PROJECT_REF=
