# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Browser / public: bundled into the app, safe to expose -------------------
# Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Dashboard > Project Settings > API > anon / publishable key
VITE_SUPABASE_ANON_KEY=

# --- CLI only / secret: never prefix with VITE_, never commit -----------------
# Project ref: the subdomain of the project URL (abcdefghijklmnop)
SUPABASE_PROJECT_REF=
# Dashboard > Account > Access Tokens (CI and function deploys; db:types uses SUPABASE_DB_URL)
SUPABASE_ACCESS_TOKEN=
# Dashboard > Connect > Session pooler (port 5432), password included.
# Used by db:push, db:reset, db:test, db:types. Percent-encode special characters in the password.
SUPABASE_DB_URL=
# Dashboard > Project Settings > Database > Database password
SUPABASE_DB_PASSWORD=
# Ref of the production project. db:reset refuses any SUPABASE_DB_URL that names it.
PROD_PROJECT_REF=

# --- Proof of payment: Cloudflare R2 (read only by api/proof.ts on Vercel; set these in the Vercel project, never VITE_) ---
# Cloudflare dashboard > R2 > your account id (the hex string in the S3 API URL)
R2_ACCOUNT_ID=
# R2 > Manage API tokens > Create token: Object Read & Write, scoped to the one bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket name. Keep it private: no public access, no custom domain.
R2_BUCKET=
